{
  "description": "Debian 13 with Docker and sudo access for a regular user.",
  "docker_registry": "https://ghcr.io",
  "image_src": "debian13-docker.svg",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/usr/local/bin/kasm_docker_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/usr/local/bin/kasm_docker_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Development",
    "Utility"
  ],
  "friendly_name": "Debian 13 with Docker",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/syscall00/debian13-docker:latest",
      "uncompressed_size_mb": 512,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
